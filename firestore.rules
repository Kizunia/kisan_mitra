rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      // Check if user is the default admin or has a document in admins collection
      return isSignedIn() &&
        (request.auth.token.email == 'admin@kisanmitra.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidStoreRatingUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).changedKeys();

      return changedKeys.hasOnly(['rating', 'totalReviews', 'ratingSum', 'updatedAt']) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 0 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.totalReviews is int &&
        request.resource.data.totalReviews >= 0 &&
        request.resource.data.ratingSum is number &&
        request.resource.data.ratingSum >= 0 &&
        request.resource.data.updatedAt == request.time;
    }

    // Users collection - farmers can read/write their own data, admins can manage all users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(userId) || isAdmin();

      // User activity subcollection - users can read/write their own activity stats
      match /activity/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Stores collection - anyone can read verified stores for search functionality
    match /stores/{storeId} {
      allow read: if true; // Public read to allow farmers to search for stores
      allow create: if isSignedIn();
      allow update: if isOwner(storeId) || isAdmin() || isValidStoreRatingUpdate();
      allow delete: if isOwner(storeId) || isAdmin();

      match /ratings/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Admins collection - read allowed for authenticated users
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Admins are created manually, not through the app
    }

    // Fertilizers collection - public read for search functionality
    match /fertilizers/{fertilizerId} {
      allow read: if true; // Public read to allow farmers to search fertilizers
      allow create: if isAdmin(); // Only admins can create fertilizers
      allow update, delete: if isAdmin(); // Only admins can update/delete fertilizers
    }

    // Store fertilizers collection - public read for search
    match /store_fertilizers/{id} {
      allow read: if true; // Public read to show fertilizer availability at stores
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Safety guidelines collection - public read for advisory screen
    match /safety_guidelines/{guidelineId} {
      allow read: if true; // Public read to show safety guidelines
      allow write: if isSignedIn(); // Authenticated users can manage guidelines
    }

    // Admin activity logs - only admins can read and write
    match /adminActivityLogs/{logId} {
      allow read: if isAdmin(); // Only admins can read activity logs
      allow create: if isAdmin(); // Only admins can create logs
      allow update, delete: if false; // Logs should never be modified or deleted
    }

    // App configuration - only admins can read and write
    match /appConfig/{configId} {
      allow read: if isAdmin(); // Only admins can read app config
      allow write: if isAdmin(); // Only admins can update app config
    }

    // Admin users collection - only admins can read and write
    match /adminUsers/{adminUserId} {
      allow read: if isAdmin(); // Only admins can read admin users
      allow write: if isAdmin(); // Only admins can manage admin users
    }

    // Admin notifications - only admins can read and write their own notifications
    match /adminNotifications/{notificationId} {
      allow read: if isAdmin(); // Only admins can read notifications
      allow create: if isAdmin(); // Only admins can create notifications
      allow update: if isAdmin(); // Only admins can update notifications (mark as read)
      allow delete: if isAdmin(); // Only admins can delete notifications
    }

    // Legal documents (Terms & Privacy) - public read, admin write
    match /legalDocuments/{docId} {
      allow read: if true; // Everyone can read terms and privacy policy
      allow write: if isAdmin(); // Only admins can update legal documents
    }

    // Roles collection - only admins can read and write
    match /roles/{roleId} {
      allow read: if isAdmin(); // Only admins can read roles
      allow write: if isAdmin(); // Only admins can manage roles
    }

    // Store users collection - only admins can read and write
    match /storeUsers/{userId} {
      allow read: if isAdmin(); // Only admins can read store users
      allow write: if isAdmin(); // Only admins can manage store users
    }
  }
}
